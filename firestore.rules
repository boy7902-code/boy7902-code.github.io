rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// 우리 가족 대시보드 · Firestore 보안 규칙 (family-bcfe4 실제 배포본의 원본)
//   · 콘솔에는 주석을 뺀 같은 내용을 한 줄로 게시했습니다(firestore.compact.rules 와 동일).
//
// 경로 지도
//   households/main                        가족 문서(이름·설정)
//   households/main/members/{memberId}     구성원 (m1·m2 성인, m3 아이)
//   households/main/missions/{missionId}   미션 정의 (부모만 쓰기)
//   households/main/logs/{date}_{mid}_m3   완료 기록 (아이가 만들고, 부모가 정산)
//   households/main/stats/summary          확정 합계 (부모만 쓰기 · 가족 읽기)
//   households/main/child_state/partner    아이가 고른 파트너 종 ID (아이만 쓰기 허용)
//   households/main/wishlist/{itemId}      사고 싶은 것
//   households/main/shopping/{itemId}      장보기·냉장고 메모
//   households/main/letters/{letterId}     손글씨 편지
//   households/main/pointUses/{useId}      포인트 사용 내역 (부모만 쓰기)
//   households/main/{events,wiki,links}/…  부모만 쓰기
//
// 역할은 Custom Claims(role)로 판별합니다. 규칙 파일이 공개 저장소에 올라가도
// 가족 이메일 주소가 드러나지 않게 하려는 선택입니다(설계 문서 3장).
//   role == 'parent'  → 부모 기기 계정
//   role == 'child'   → 아이 계정 (구성원 ID m3 고정)
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    /* ───────────────────────── 공통 헬퍼 ───────────────────────── */
    function isParent() {
      return request.auth != null
        && 'role' in request.auth.token
        && request.auth.token['role'] == 'parent';
    }
    function isChild() {
      return request.auth != null
        && 'role' in request.auth.token
        && request.auth.token['role'] == 'child';
    }
    function isFamily() {
      return isParent() || isChild();
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // 서버 시각(request.time)을 KST(UTC+9) 및 보드 +5분으로 옮긴 값 — 기기 시계는 신뢰하지 않습니다.
    function kstNow() {
      return request.time + duration.value(9, 'h') + duration.value(5, 'm');
    }
    function kstDate(ts) {
      return string(ts.year()) + '-' + pad2(ts.month()) + '-' + pad2(ts.day());
    }
    function kstMinutes(ts) {
      return ts.hours() * 60 + ts.minutes();
    }
    function isTodayKst(dateStr) {
      return dateStr is string && dateStr == kstDate(kstNow());
    }

    // 'HH:MM' → 자정부터의 분
    function hhmmToMin(s) {
      let p = s.split(':');
      return int(p[0]) * 60 + int(p[1]);
    }
    // 'HH:MM' 은 실제 시각만: 00:00 ~ 23:59 (24:00·29:59 같은 값은 통과하지 못합니다)
    function isHhmm(s) {
      return s is string && s.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }
    // 마감 시각(due)은 없으면 '', 있으면 반드시 'HH:MM'(00:00~23:59)
    function dueOk(s) {
      return s is string && (s == '' || isHhmm(s));
    }
    // 미션 담당자: '' = 공용, m1·m2 = 성인, m3 = 아이
    function memberOk(s) {
      return s is string && (s == '' || s == 'm1' || s == 'm2' || s == 'm3');
    }
    // 기록 시각(at)은 서버 시각보다 뒤일 수 없고, 15분 넘게 앞설 수도 없습니다.
    // 자정을 넘기거나 오프라인으로 늦게 도착한 기록은 이 조건에서 거절됩니다(앱은 안내 후 재시도).
    function atNearServerTime(atStr) {
      let m = hhmmToMin(atStr);
      let now = kstMinutes(kstNow());
      return isHhmm(atStr) && m <= now && now - m <= 15;
    }
    function goalMetOf(atStr, dueStr) {
      return dueStr != '' && isHhmm(dueStr) && hhmmToMin(atStr) <= hhmmToMin(dueStr);
    }
    function earlyBonusOf(atStr, dueStr) {
      return dueStr != '' && isHhmm(dueStr) && isHhmm(atStr)
        ? (hhmmToMin(dueStr) - hhmmToMin(atStr) >= 10 ? 2
          : (hhmmToMin(dueStr) - hhmmToMin(atStr) >= 5 ? 1 : 0))
        : 0;
    }

    /* ───────────────────────── 가족 문서 ───────────────────────── */
    match /households/{hh} {
      allow read: if isFamily();
      allow write: if isParent();
    }

    /* ───────────────── 구성원 · 일정 · 위키 · 링크 · 미션 ─────────────────
       모두 부모만 쓰고, 가족은 읽습니다. 아이는 미션 점수·마감 시각을 읽어
       자기 화면을 그립니다(규칙의 교차 검증도 같은 문서를 봅니다). */
    match /households/{hh}/members/{docId}   { allow read: if isFamily(); allow write: if isParent(); }
    match /households/{hh}/events/{docId}    { allow read: if isFamily(); allow write: if isParent(); }
    match /households/{hh}/wiki/{docId}      { allow read: if isFamily(); allow write: if isParent(); }
    match /households/{hh}/links/{docId}     { allow read: if isFamily(); allow write: if isParent(); }
    match /households/{hh}/pointUses/{docId} { allow read: if isFamily(); allow write: if isParent(); }

    // 부모가 미션을 쓸 때 due(마감 시각)와 member(담당자)만 모양을 검사합니다.
    // due ''(마감 없음)은 그대로 허용하고, 값이 있으면 00:00~23:59 만 통과합니다.
    match /households/{hh}/missions/{missionId} {
      allow read: if isFamily();
      allow write: if isParent() && missionShape();
    }

    function missionShape() {
      let d = request.resource.data;
      return (!d.keys().hasAll(['due']) || dueOk(d.due))
        && (!d.keys().hasAll(['member']) || memberOk(d.member));
    }

    /* ───────────────────────── 완료 기록(logs) ─────────────────────────
       아이 : 오늘(KST) · 본인(m3) · 미정산 로그만 create/delete, update 금지
       부모 : 완료 기록을 create/read/update/delete 할 수 있음(기존 운영 권한 유지)
       문서 ID 규칙: {date}_{mid}_m3 → 같은 날 같은 미션 중복 생성을 원천 차단 */
    match /households/{hh}/logs/{logId} {
      allow read: if isFamily();
      allow create: if isParent() || (isChild() && (('giftId' in request.resource.data && praiseLogCreate(hh, logId)) || childLogCreate(hh, logId)));
      allow update: if isParent();
      allow delete: if isParent()
        || (isChild() && childLogDelete());
    }

    function childLogCreate(hh, logId) {
      let d = request.resource.data;
      let m = get(/databases/$(database)/documents/households/$(hh)/missions/$(d.mid)).data;
      let due = m.get('due', '');
      return d.keys().hasAll(['id', 'date', 'at', 'mid', 'title', 'member', 'base', 'bonus', 'earlyBonus',
                              'earned', 'due', 'goalMet', 'settled', 'createdAt', 'createdBy'])
        && d.keys().hasOnly(['id', 'date', 'at', 'mid', 'title', 'member', 'base', 'bonus', 'earlyBonus',
                             'earned', 'due', 'goalMet', 'settled', 'createdAt', 'createdBy'])
        // 문서 ID = 날짜_미션_구성원 (중복·중복 ID 조작 차단)
        && logId == d.date + '_' + d.mid + '_' + d.member
        // 로그의 member 는 '완료한 사람' — 아이 기기에서 만드는 로그는 항상 m3
        && d.member == 'm3'
        // 실제로 등록된 '아이 담당' 또는 '공용' 미션인지 교차 검증
        //   공용 미션(member == '')은 아이가 완료할 수 있습니다(앱 정책: visibleMissions 가 공용을 포함)
        //   성인 미션(m1·m2)은 아이가 완료할 수 없습니다
        && (m.member == 'm3' || m.member == '')
        && d.title == m.get('title', '')
        // 마감 시각은 미션 문서 값 그대로 + 형식은 00:00~23:59 (깨진 값 24:00·29:59 차단)
        && d.due == due
        && dueOk(due)
        && d.base is int && d.base == m.get('points', 0)
        // 날짜는 서버 시각 기준 오늘만 (미래·과거 날짜 차단)
        && isTodayKst(d.date)
        // 만든 시각·만든 사람은 서버가 정한 값만
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid
        // 미정산 상태로만 만들 수 있음
        && d.settled == false
        // 완료 시각은 서버 시각과 15분 이내
        && atNearServerTime(d.at)
        // 마감 상태와 점수는 서버가 계산하며, 구형 미션별 마감 보너스는 더 이상 허용하지 않음
        && d.goalMet == goalMetOf(d.at, due)
        && d.bonus is int && d.bonus == 0
        && d.earlyBonus is int && d.earlyBonus == earlyBonusOf(d.at, due)
        && d.earned == d.base + d.earlyBonus;
    }

    // 아이는 자기가 만든 · 오늘 · 아직 정산되지 않은 기록만 지울 수 있습니다(체크 취소).
    function childLogDelete() {
      return !('giftId' in resource.data) && resource.data.createdBy == request.auth.uid
        && resource.data.member == 'm3'
        && resource.data.settled == false
        && isTodayKst(resource.data.date);
    }

    /* Parent-issued praise gifts. A child may consume one existing gift only as
       the paired, exact bonus log is created in the same atomic transaction. */
    match /households/{hh}/praiseGifts/{giftId} {
      allow read: if isFamily();
      allow create: if isParent() && praiseGiftCreate(giftId);
      allow update: if isFamily() && praiseGiftClaim(hh, giftId);
      allow delete: if false;
    }
    function praiseGiftCreate(giftId) {
      let d = request.resource.data;
      return giftId.matches('^[a-f0-9]{32}$')
        && d.keys().hasOnly(['id','member','reason','points','policyVersion','state','createdAt','createdBy'])
        && d.keys().hasAll(['id','member','reason','points','policyVersion','state','createdAt','createdBy'])
        && d.id == giftId && d.member == 'm3' && d.state == 'ready'
        && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 40
        && d.points is int && d.points in [1,2,3,5,10]
        && d.policyVersion == 'praise-20261122-v1'
        && d.createdAt == request.time && d.createdBy == request.auth.uid;
    }
    function praiseReceiptMatches(gift, receipt, giftId) {
      return receipt.keys().hasOnly(['id','date','at','mid','giftId','title','kind','member','base','bonus','earlyBonus','earned','due','goalMet','settled','createdAt','createdBy'])
        && receipt.keys().hasAll(['id','date','at','mid','giftId','title','kind','member','base','bonus','earlyBonus','earned','due','goalMet','settled','createdAt','createdBy'])
        && receipt.id == 'praise_' + giftId && receipt.mid == 'praise_' + giftId && receipt.giftId == giftId
        && receipt.member == 'm3' && receipt.kind == 'bonus'
        && receipt.title == '🎁 칭찬 선물 · ' + gift.reason
        && receipt.base == gift.points && receipt.earned == gift.points
        && receipt.bonus == 0 && receipt.earlyBonus == 0 && receipt.due == '' && receipt.goalMet == false && receipt.settled == false
        && receipt.createdAt == request.time && receipt.createdBy == request.auth.uid
        && isTodayKst(receipt.date) && atNearServerTime(receipt.at);
    }
    function praiseGiftClaim(hh, giftId) {
      let before = resource.data;
      let after = request.resource.data;
      let logPath = /databases/$(database)/documents/households/$(hh)/logs/$('praise_' + giftId);
      let receipt = getAfter(logPath).data;
      return before.member == 'm3' && before.state == 'ready' && after.state == 'claimed'
        && after.diff(before).affectedKeys().hasOnly(['state','openedAt','openedBy','claimDate','claimAt'])
        && after.openedAt == request.time && after.openedBy == request.auth.uid
        && after.claimDate == receipt.date && after.claimAt == receipt.at
        && !exists(logPath) && praiseReceiptMatches(before, receipt, giftId);
    }
    function praiseLogCreate(hh, logId) {
      let d = request.resource.data;
      let giftId = d.giftId;
      let giftPath = /databases/$(database)/documents/households/$(hh)/praiseGifts/$(giftId);
      let before = get(giftPath).data;
      let after = getAfter(giftPath).data;
      return giftId is string && giftId.matches('^[a-f0-9]{32}$') && logId == 'praise_' + giftId
        && before.member == 'm3' && before.state == 'ready' && after.state == 'claimed'
        && after.openedAt == request.time && after.openedBy == request.auth.uid
        && after.claimDate == d.date && after.claimAt == d.at
        && praiseReceiptMatches(before, d, giftId);
    }

    /* ───────────────────── 확정 합계(stats/summary) ─────────────────────
       부모만 쓸 수 있습니다. 아이는 읽기만 하므로 경험치·잔액·월별 합계를
       직접 올리거나 지울 경로가 없습니다. */
    match /households/{hh}/stats/summary {
      allow read: if isFamily();
      allow write: if isParent() && summaryShape();
    }

    function summaryShape() {
      let d = request.resource.data;
      return d.keys().hasAll(['totalXp', 'settledCount', 'monthly', 'updatedAt'])
        && d.totalXp is int && d.totalXp >= 0 && d.totalXp <= 10000000
        && d.settledCount is int && d.settledCount >= 0
        && d.monthly is map
        && d.updatedAt == request.time;
    }

    /* ─────────────── 아이가 고른 파트너(child_state/partner) ───────────────
       진화·도감(XP·해금 목록)은 저장하지 않고 stats/summary + logs에서 계산합니다.
       아이가 직접 고를 수 있는 값은 '파트너 종 ID' 하나뿐이므로,
       아이가 쓸 수 있는 문서는 이 한 칸으로 제한합니다. */
    match /households/{hh}/child_state/partner {
      allow read: if isFamily();
      allow write: if (isParent() && (partnerShape() || explicitPartnerRestore())) || (isChild() && partnerShape());
    }
    match /households/{hh}/child_state/{docId} {
      allow read: if isFamily();
      allow write: if isParent() && docId != 'partner';
    }

    /* ───────────── 부모 전용 비공개 설정(private) ─────────────
       부모 PIN·테마·백업 상태처럼 아이 화면에 내려보내지 않아야 하는 값만 둡니다.
       가족 이메일 목록·서비스 계정 키는 어떤 문서에도 저장하지 않습니다(3장). */
    match /households/{hh}/private/{docId} {
      allow read, write: if isParent();
    }

    function explicitPartnerRestore() {
      let d = request.resource.data;
      return d.keys().hasAll(['partnerKey', 'updatedAt', 'restoreIntent'])
        && d.keys().hasOnly(['partnerKey', 'sinceXp', 'growth', 'updatedAt', 'restoreIntent'])
        && d.partnerKey is string && d.partnerKey.matches('^[a-z0-9-]{1,40}$')
        && d.updatedAt == request.time
        && (!d.keys().hasAll(['sinceXp']) || (d.sinceXp is int && d.sinceXp >= 0 && d.sinceXp <= 10000000))
        && d.restoreIntent == request.time
        && (!request.resource.data.keys().hasAll(['growth']) || partnerGrowthShape(request.resource.data.growth));
    }
    function partnerShape() {
      let d = request.resource.data;
      return d.keys().hasAll(['partnerKey', 'updatedAt'])
        && d.keys().hasOnly(['partnerKey', 'sinceXp', 'growth', 'updatedAt', 'restoreIntent'])
        && d.partnerKey is string
        && d.partnerKey.matches('^[a-z0-9-]{1,40}$')
        // sinceXp = 새 파트너를 입양한 시점의 누적 경험치(진화 게이지 기준점). 없어도 됩니다.
        && (!d.keys().hasAll(['sinceXp']) || (d.sinceXp is int && d.sinceXp >= 0 && d.sinceXp <= 10000000))
        && (!d.keys().hasAll(['growth']) || partnerGrowthShape(d.growth))
        && partnerGrowthForward(d)
        && d.updatedAt == request.time;
    }
    function partnerGrowthShape(g) {
      return g is map && g.keys().hasAll(['cycleId','hatched','celebrated'])
        && g.keys().hasOnly(['cycleId','hatched','celebrated'])
        && g.cycleId is string && g.cycleId.matches('^[a-zA-Z0-9-]{1,80}$')
        && g.hatched is bool && g.celebrated is bool
        && g.hatched == g.celebrated;
    }
    function partnerGrowthForward(d) {
      return !exists(/databases/$(database)/documents/households/main/child_state/partner)
        || !resource.data.keys().hasAll(['growth'])
        || (d.keys().hasAll(['growth']) && (
          (d.growth.cycleId == resource.data.growth.cycleId
            && (!resource.data.growth.hatched || d.growth.hatched))
          || (d.growth.cycleId != resource.data.growth.cycleId
            && !d.growth.hatched && !d.growth.celebrated)
        ));
    }

    /* ───────────────────────── 사고 싶은 것(wishlist) ─────────────────────────
       아이 : 만들기 가능, 지우기는 '내가 만든 것'만. 수정(필요 포인트·선물 처리)은 부모만.
       → 아이가 need(필요 포인트)나 boughtAt(선물 받은 날)을 스스로 바꿀 수 없습니다. */
    match /households/{hh}/wishlist/{itemId} {
      allow read: if isFamily();
      allow create: if isFamily() && wishCreate();
      allow update: if isParent();
      allow delete: if isParent()
        || (isFamily() && resource.data.createdBy == request.auth.uid);
    }

    function wishCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'title', 'need', 'cat', 'at', 'by', 'boughtAt', 'createdBy', 'createdAt'])
        && d.keys().hasOnly(['id', 'title', 'need', 'cat', 'at', 'by', 'boughtAt', 'createdBy', 'createdAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && d.need is int && d.need >= 0 && d.need <= 100000
        && d.cat in ['toy', 'supply', 'book', 'etc']
        && d.at is string && d.at.size() <= 10
        && d.by is string && d.by.size() <= 8
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time
        // 선물 처리(boughtAt)는 부모만 — 아이는 빈 값으로만 만들 수 있습니다
        && (isParent() || (d.boughtAt == '' && d.by == 'm3'));
    }

    /* ───────────────────── 장보기 · 편지 (createdBy 기록) ─────────────────────
       수정·삭제는 '만든 사람 또는 부모'만 가능합니다. */
    match /households/{hh}/shopping/{itemId} {
      allow read: if isFamily();
      allow create: if isFamily() && shoppingCreate();
      allow update: if (isParent() || (isFamily() && resource.data.createdBy == request.auth.uid))
        && shoppingUpdate();
      allow delete: if isParent()
        || (isFamily() && resource.data.createdBy == request.auth.uid);
    }

    function shoppingCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'cat', 'text', 'done', 'createdBy', 'createdAt'])
        && d.keys().hasOnly(['id', 'cat', 'text', 'done', 'createdBy', 'createdAt'])
        && d.cat in ['buy', 'fridge']
        && d.text is string && d.text.size() > 0 && d.text.size() <= 80
        && d.done is bool
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time;
    }

    /* 수정 검증: 값·길이 규칙은 그대로, 만든 사람(createdBy)·만든 시각(createdAt)·id 는
       바꿀 수 없습니다(다른 사람 항목을 가로채거나 기록을 위조하는 길을 막습니다).
       · 예전 문서에 그 필드가 아예 없을 수 있어, '있을 때만 같아야 한다'로 씁니다. */
    function shoppingUpdate() {
      let d = request.resource.data;      // 수정 뒤 문서
      let p = resource.data;              // 수정 전 문서
      return d.keys().hasAll(['id', 'cat', 'text', 'done', 'createdBy', 'createdAt'])
        && d.keys().hasOnly(['id', 'cat', 'text', 'done', 'createdBy', 'createdAt'])
        && d.cat in ['buy', 'fridge']
        && d.text is string && d.text.size() > 0 && d.text.size() <= 80
        && d.done is bool
        && (!p.keys().hasAll(['id']) || d.id == p.id)
        && (!p.keys().hasAll(['createdBy']) || d.createdBy == p.createdBy)
        && (!p.keys().hasAll(['createdAt']) || d.createdAt == p.createdAt);
    }

    match /households/{hh}/letters/{letterId} {
      allow read: if isFamily();
      allow create: if isFamily() && letterCreate();
      allow update: if (isParent() || (isFamily() && resource.data.createdBy == request.auth.uid))
        && letterUpdate();
      allow delete: if isParent()
        || (isFamily() && resource.data.createdBy == request.auth.uid);
    }

    function letterCreate() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'img', 'author', 'when', 'createdBy', 'createdAt'])
        && d.keys().hasOnly(['id', 'img', 'author', 'when', 'createdBy', 'createdAt'])
        // 그림은 data URL 문자열 — 문서 1MiB 한도 안에서만 허용
        && d.img is string && d.img.size() > 32 && d.img.size() <= 700000
        && d.author is string && d.author.size() <= 20
        && d.when is string && d.when.size() <= 20
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time;
    }

    /* 수정 검증: 그림·작성자·시각의 길이 한도를 그대로 지키고,
       만든 사람·만든 시각·id 는 바꿀 수 없습니다. */
    function letterUpdate() {
      let d = request.resource.data;
      let p = resource.data;
      return d.keys().hasAll(['id', 'img', 'author', 'when', 'createdBy', 'createdAt'])
        && d.keys().hasOnly(['id', 'img', 'author', 'when', 'createdBy', 'createdAt'])
        && d.img is string && d.img.size() > 32 && d.img.size() <= 700000
        && d.author is string && d.author.size() <= 20
        && d.when is string && d.when.size() <= 20
        && (!p.keys().hasAll(['id']) || d.id == p.id)
        && (!p.keys().hasAll(['createdBy']) || d.createdBy == p.createdBy)
        && (!p.keys().hasAll(['createdAt']) || d.createdAt == p.createdAt);
    }
  }
}
