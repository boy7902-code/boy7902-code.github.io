rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function isParent() { return request.auth != null && 'role' in request.auth.token && request.auth.token['role'] == 'parent'; } function isChild() { return request.auth != null && 'role' in request.auth.token && request.auth.token['role'] == 'child'; } function isFamily() { return isParent() || isChild(); } function pad2(n) { return n < 10 ? '0' + string(n) : string(n); } function kstNow() { return request.time + duration.value(9, 'h') + duration.value(5, 'm'); } function kstDate(ts) { return string(ts.year()) + '-' + pad2(ts.month()) + '-' + pad2(ts.day()); } function kstMinutes(ts) { return ts.hours() * 60 + ts.minutes(); } function isTodayKst(dateStr) { return dateStr is string && dateStr == kstDate(kstNow()); } function hhmmToMin(s) { let p = s.split(':'); return int(p[0]) * 60 + int(p[1]); } function isHhmm(s) { return s is string && s.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); } function dueOk(s) { return s is string && (s == '' || isHhmm(s)); } function memberOk(s) { return s is string && (s == '' || s == 'm1' || s == 'm2' || s == 'm3'); } function atNearServerTime(atStr) { let m = hhmmToMin(atStr); let now = kstMinutes(kstNow()); return isHhmm(atStr) && m <= now && now - m <= 15; } function goalMetOf(atStr, dueStr) { return dueStr != '' && isHhmm(dueStr) && hhmmToMin(atStr) <= hhmmToMin(dueStr); } function earlyBonusOf(atStr, dueStr) { return dueStr != '' && isHhmm(dueStr) && isHhmm(atStr) ? (hhmmToMin(dueStr) - hhmmToMin(atStr) >= 10 ? 2 : (hhmmToMin(dueStr) - hhmmToMin(atStr) >= 5 ? 1 : 0)) : 0; } match /households/{hh} { allow read: if isFamily(); allow write: if isParent(); } match /households/{hh}/members/{docId} { allow read: if isFamily(); allow write: if isParent(); } match /households/{hh}/events/{docId} { allow read: if isFamily(); allow write: if isParent(); } match /households/{hh}/wiki/{docId} { allow read: if isFamily(); allow write: if isParent(); } match /households/{hh}/links/{docId} { allow read: if isFamily(); allow write: if isParent(); } match /households/{hh}/pointUses/{docId} { allow read: if isFamily(); allow write: if isParent(); } match /households/{hh}/missions/{missionId} { allow read: if isFamily(); allow create, update: if isParent() && missionShape(); allow delete: if isParent(); } function missionShape() { let d = request.resource.data; return (!d.keys().hasAll(['due']) || dueOk(d.due)) && (!d.keys().hasAll(['member']) || memberOk(d.member)) && (!d.keys().hasAll(['weekendDue']) || dueOk(d.weekendDue)); } match /households/{hh}/logs/{logId} { allow read: if isFamily(); allow create: if isParent() || (isChild() && (('giftId' in request.resource.data && praiseLogCreate(hh, logId)) || childLogCreate(hh, logId))); allow update: if isParent(); allow delete: if isParent() || (isChild() && childLogDelete()); } function missionDue(hh, m) { let now = kstNow(); let weekend = now.dayOfWeek() == 6 || now.dayOfWeek() == 7; let calendar = get(/databases/$(database)/documents/households/$(hh)/child_state/holiday_calendar).data; let holiday = kstDate(now) in calendar.get('dates', []); let covered = string(now.year()) in calendar.get('years', []); return covered && (weekend || holiday) ? m.get('weekendDue', m.get('due', '')) : m.get('due', ''); } function selectedDue(hh, m) { return m.get('weekendDue', '') != '' ? missionDue(hh, m) : m.get('due', ''); } function childLogCreate(hh, logId) { let d = request.resource.data; let m = get(/databases/$(database)/documents/households/$(hh)/missions/$(d.mid)).data; let due = selectedDue(hh, m); return d.keys().hasAll(['id', 'date', 'at', 'mid', 'title', 'member', 'base', 'bonus', 'earlyBonus', 'earned', 'due', 'goalMet', 'settled', 'createdAt', 'createdBy']) && d.keys().hasOnly(['id', 'date', 'at', 'mid', 'title', 'member', 'base', 'bonus', 'earlyBonus', 'earned', 'due', 'goalMet', 'settled', 'createdAt', 'createdBy']) && logId == d.date + '_' + d.mid + '_' + d.member && d.member == 'm3' && (m.member == 'm3' || m.member == '') && m.get('archived', false) != true && d.title == m.get('title', '') && d.due == due && dueOk(due) && (m.get('weekendDue', '') == '' || string(kstNow().year()) in get(/databases/$(database)/documents/households/$(hh)/child_state/holiday_calendar).data.get('years', [])) && d.base is int && d.base == m.get('points', 0) && isTodayKst(d.date) && d.createdAt == request.time && d.createdBy == request.auth.uid && d.settled == false && atNearServerTime(d.at) && d.goalMet == goalMetOf(d.at, due) && d.bonus is int && d.bonus == 0 && d.earlyBonus is int && d.earlyBonus == earlyBonusOf(d.at, due) && d.earned == d.base + d.earlyBonus; } function childLogDelete() { return !('giftId' in resource.data) && resource.data.createdBy == request.auth.uid && resource.data.member == 'm3' && resource.data.settled == false && isTodayKst(resource.data.date); } match /households/{hh}/praiseGifts/{giftId} { allow read: if isFamily(); allow create: if isParent() && praiseGiftCreate(giftId); allow update: if isFamily() && praiseGiftClaim(hh, giftId); allow delete: if false; } function praiseGiftCreate(giftId) { let d = request.resource.data; return giftId.matches('^[a-f0-9]{32}$') && d.keys().hasOnly(['id','member','reason','points','policyVersion','state','createdAt','createdBy']) && d.keys().hasAll(['id','member','reason','points','policyVersion','state','createdAt','createdBy']) && d.id == giftId && d.member == 'm3' && d.state == 'ready' && d.reason is string && d.reason.size() > 0 && d.reason.size() <= 40 && d.points is int && d.points in [1,2,3,5,10] && d.policyVersion == 'praise-20261122-v1' && d.createdAt == request.time && d.createdBy == request.auth.uid; } function praiseReceiptMatches(gift, receipt, giftId) { return receipt.keys().hasOnly(['id','date','at','mid','giftId','title','kind','member','base','bonus','earlyBonus','earned','due','goalMet','settled','createdAt','createdBy']) && receipt.keys().hasAll(['id','date','at','mid','giftId','title','kind','member','base','bonus','earlyBonus','earned','due','goalMet','settled','createdAt','createdBy']) && receipt.id == 'praise_' + giftId && receipt.mid == 'praise_' + giftId && receipt.giftId == giftId && receipt.member == 'm3' && receipt.kind == 'bonus' && receipt.title == '🎁 칭찬 선물 · ' + gift.reason && receipt.base == gift.points && receipt.earned == gift.points && receipt.bonus == 0 && receipt.earlyBonus == 0 && receipt.due == '' && receipt.goalMet == false && receipt.settled == false && receipt.createdAt == request.time && receipt.createdBy == request.auth.uid && isTodayKst(receipt.date) && atNearServerTime(receipt.at); } function praiseGiftClaim(hh, giftId) { let before = resource.data; let after = request.resource.data; let logPath = /databases/$(database)/documents/households/$(hh)/logs/$('praise_' + giftId); let receipt = getAfter(logPath).data; return before.member == 'm3' && before.state == 'ready' && after.state == 'claimed' && after.diff(before).affectedKeys().hasOnly(['state','openedAt','openedBy','claimDate','claimAt']) && after.openedAt == request.time && after.openedBy == request.auth.uid && after.claimDate == receipt.date && after.claimAt == receipt.at && !exists(logPath) && praiseReceiptMatches(before, receipt, giftId); } function praiseLogCreate(hh, logId) { let d = request.resource.data; let giftId = d.giftId; let giftPath = /databases/$(database)/documents/households/$(hh)/praiseGifts/$(giftId); let before = get(giftPath).data; let after = getAfter(giftPath).data; return giftId is string && giftId.matches('^[a-f0-9]{32}$') && logId == 'praise_' + giftId && before.member == 'm3' && before.state == 'ready' && after.state == 'claimed' && after.openedAt == request.time && after.openedBy == request.auth.uid && after.claimDate == d.date && after.claimAt == d.at && praiseReceiptMatches(before, d, giftId); } match /households/{hh}/stats/summary { allow read: if isFamily(); allow write: if isParent() && summaryShape(); } function summaryShape() { let d = request.resource.data; return d.keys().hasAll(['totalXp', 'settledCount', 'monthly', 'updatedAt']) && d.totalXp is int && d.totalXp >= 0 && d.totalXp <= 10000000 && d.settledCount is int && d.settledCount >= 0 && d.monthly is map && d.updatedAt == request.time; } match /households/{hh}/child_state/partner { allow read: if isFamily(); allow write: if (isParent() && (partnerShape() || explicitPartnerRestore())) || (isChild() && partnerShape()); } match /households/{hh}/child_state/{docId} { allow read: if isFamily(); allow write: if isParent() && docId != 'partner'; } match /households/{hh}/private/{docId} { allow read, write: if isParent(); } function explicitPartnerRestore() { let d = request.resource.data; return d.keys().hasAll(['partnerKey', 'updatedAt', 'restoreIntent']) && d.keys().hasOnly(['partnerKey', 'sinceXp', 'growth', 'updatedAt', 'restoreIntent']) && d.partnerKey is string && d.partnerKey.matches('^[a-z0-9-]{1,40}$') && d.updatedAt == request.time && (!d.keys().hasAll(['sinceXp']) || (d.sinceXp is int && d.sinceXp >= 0 && d.sinceXp <= 10000000)) && d.restoreIntent == request.time && (!request.resource.data.keys().hasAll(['growth']) || partnerGrowthShape(request.resource.data.growth)); } function partnerShape() { let d = request.resource.data; return d.keys().hasAll(['partnerKey', 'updatedAt']) && d.keys().hasOnly(['partnerKey', 'sinceXp', 'growth', 'updatedAt', 'restoreIntent']) && d.partnerKey is string && d.partnerKey.matches('^[a-z0-9-]{1,40}$') && (!d.keys().hasAll(['sinceXp']) || (d.sinceXp is int && d.sinceXp >= 0 && d.sinceXp <= 10000000)) && (!d.keys().hasAll(['growth']) || partnerGrowthShape(d.growth)) && partnerGrowthForward(d) && d.updatedAt == request.time; } function partnerGrowthShape(g) { return g is map && g.keys().hasAll(['cycleId','hatched','celebrated']) && g.keys().hasOnly(['cycleId','hatched','celebrated']) && g.cycleId is string && g.cycleId.matches('^[a-zA-Z0-9-]{1,80}$') && g.hatched is bool && g.celebrated is bool && g.hatched == g.celebrated; } function partnerGrowthForward(d) { return !exists(/databases/$(database)/documents/households/main/child_state/partner) || !resource.data.keys().hasAll(['growth']) || (d.keys().hasAll(['growth']) && ( (d.growth.cycleId == resource.data.growth.cycleId && (!resource.data.growth.hatched || d.growth.hatched)) || (d.growth.cycleId != resource.data.growth.cycleId && !d.growth.hatched && !d.growth.celebrated) )); } match /households/{hh}/wishlist/{itemId} { allow read: if isFamily(); allow create: if isFamily() && wishCreate(); allow update: if isParent(); allow delete: if isParent() || (isFamily() && resource.data.createdBy == request.auth.uid); } function wishCreate() { let d = request.resource.data; return d.keys().hasAll(['id', 'title', 'need', 'cat', 'at', 'by', 'boughtAt', 'createdBy', 'createdAt']) && d.keys().hasOnly(['id', 'title', 'need', 'cat', 'at', 'by', 'boughtAt', 'createdBy', 'createdAt']) && d.title is string && d.title.size() > 0 && d.title.size() <= 40 && d.need is int && d.need >= 0 && d.need <= 100000 && d.cat in ['toy', 'supply', 'book', 'etc'] && d.at is string && d.at.size() <= 10 && d.by is string && d.by.size() <= 8 && d.createdBy == request.auth.uid && d.createdAt == request.time && (isParent() || (d.boughtAt == '' && d.by == 'm3')); } match /households/{hh}/shopping/{itemId} { allow read: if isFamily(); allow create: if isFamily() && shoppingCreate(); allow update: if (isParent() || (isFamily() && resource.data.createdBy == request.auth.uid)) && shoppingUpdate(); allow delete: if isParent() || (isFamily() && resource.data.createdBy == request.auth.uid); } function shoppingCreate() { let d = request.resource.data; return d.keys().hasAll(['id', 'cat', 'text', 'done', 'createdBy', 'createdAt']) && d.keys().hasOnly(['id', 'cat', 'text', 'done', 'createdBy', 'createdAt']) && d.cat in ['buy', 'fridge'] && d.text is string && d.text.size() > 0 && d.text.size() <= 80 && d.done is bool && d.createdBy == request.auth.uid && d.createdAt == request.time; } function shoppingUpdate() { let d = request.resource.data; let p = resource.data; return d.keys().hasAll(['id', 'cat', 'text', 'done', 'createdBy', 'createdAt']) && d.keys().hasOnly(['id', 'cat', 'text', 'done', 'createdBy', 'createdAt']) && d.cat in ['buy', 'fridge'] && d.text is string && d.text.size() > 0 && d.text.size() <= 80 && d.done is bool && (!p.keys().hasAll(['id']) || d.id == p.id) && (!p.keys().hasAll(['createdBy']) || d.createdBy == p.createdBy) && (!p.keys().hasAll(['createdAt']) || d.createdAt == p.createdAt); } match /households/{hh}/letters/{letterId} { allow read: if isFamily(); allow create: if isFamily() && letterCreate(); allow update: if (isParent() || (isFamily() && resource.data.createdBy == request.auth.uid)) && letterUpdate(); allow delete: if isParent() || (isFamily() && resource.data.createdBy == request.auth.uid); } function letterCreate() { let d = request.resource.data; return d.keys().hasAll(['id', 'img', 'author', 'when', 'createdBy', 'createdAt']) && d.keys().hasOnly(['id', 'img', 'author', 'when', 'createdBy', 'createdAt']) && d.img is string && d.img.size() > 32 && d.img.size() <= 700000 && d.author is string && d.author.size() <= 20 && d.when is string && d.when.size() <= 20 && d.createdBy == request.auth.uid && d.createdAt == request.time; } function letterUpdate() { let d = request.resource.data; let p = resource.data; return d.keys().hasAll(['id', 'img', 'author', 'when', 'createdBy', 'createdAt']) && d.keys().hasOnly(['id', 'img', 'author', 'when', 'createdBy', 'createdAt']) && d.img is string && d.img.size() > 32 && d.img.size() <= 700000 && d.author is string && d.author.size() <= 20 && d.when is string && d.when.size() <= 20 && (!p.keys().hasAll(['id']) || d.id == p.id) && (!p.keys().hasAll(['createdBy']) || d.createdBy == p.createdBy) && (!p.keys().hasAll(['createdAt']) || d.createdAt == p.createdAt); } } }
