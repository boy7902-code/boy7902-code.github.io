rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function isParent() { return request.auth != null && 'role' in request.auth.token && request.auth.token['role'] == 'parent'; } function isChild() { return request.auth != null && 'role' in request.auth.token && request.auth.token['role'] == 'child'; } function isFamily() { return isParent() || isChild(); } function pad2(n) { return n < 10 ? '0' + string(n) : string(n); } function kstNow() { return request.time + duration.value(9, 'h'); } function kstDate(ts) { return string(ts.year()) + '-' + pad2(ts.month()) + '-' + pad2(ts.day()); } function kstMinutes(ts) { return ts.hours() * 60 + ts.minutes(); } function isTodayKst(dateStr) { return dateStr is string && dateStr == kstDate(kstNow()); } function hhmmToMin(s) { let p = s.split(':'); return int(p[0]) * 60 + int(p[1]); } function isHhmm(s) { return s is string && s.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'); } function dueOk(s) { return s is string && (s == '' || isHhmm(s)); } function memberOk(s) { return s is string && (s == '' || s == 'm1' || s == 'm2' || s == 'm3'); } function atNearServerTime(atStr) { let m = hhmmToMin(atStr); let now = kstMinutes(kstNow()); return isHhmm(atStr) && m <= now && now - m <= 15; } function goalMetOf(atStr, dueStr) { return dueStr != '' && isHhmm(dueStr) && hhmmToMin(atStr) <= hhmmToMin(dueStr); } function earlyBonusOf(atStr, dueStr) { return dueStr != '' && isHhmm(dueStr) && isHhmm(atStr) ? (hhmmToMin(dueStr) - hhmmToMin(atStr) >= 10 ? 2 : (hhmmToMin(dueStr) - hhmmToMin(atStr) >= 5 ? 1 : 0)) : 0; } match /households/{hh} { allow read: if isFamily(); allow write: if isParent(); } match /households/{hh}/members/{docId} { allow read: if isFamily(); allow write: if isParent(); } match /households/{hh}/events/{docId} { allow read: if isFamily(); allow write: if isParent(); } match /households/{hh}/wiki/{docId} { allow read: if isFamily(); allow write: if isParent(); } match /households/{hh}/links/{docId} { allow read: if isFamily(); allow write: if isParent(); } match /households/{hh}/pointUses/{docId} { allow read: if isFamily(); allow write: if isParent(); } match /households/{hh}/missions/{missionId} { allow read: if isFamily(); allow write: if isParent() && missionShape(); } function missionShape() { let d = request.resource.data; return (!d.keys().hasAll(['due']) || dueOk(d.due)) && (!d.keys().hasAll(['member']) || memberOk(d.member)); } match /households/{hh}/logs/{logId} { allow read: if isFamily(); allow create: if isParent() || (isChild() && childLogCreate(hh, logId)); allow update: if isParent() && parentLogSettlementUpdate(); allow delete: if (isParent() && resource.data.get('settled', false) == false) || (isChild() && childLogDelete()); } function parentLogSettlementUpdate() { let before = resource.data; let after = request.resource.data; return before.get('settled', false) == false && after.get('settled', false) == true && after.diff(before).affectedKeys().hasOnly(['settled', 'settledAt', 'settledBy']) && after.settledAt == request.time && after.settledBy == request.auth.uid; } function childLogCreate(hh, logId) { let d = request.resource.data; let m = get(/databases/$(database)/documents/households/$(hh)/missions/$(d.mid)).data; let due = m.get('due', ''); return d.keys().hasAll(['id', 'date', 'at', 'mid', 'title', 'member', 'base', 'bonus', 'earlyBonus', 'earned', 'due', 'goalMet', 'settled', 'createdAt', 'createdBy']) && d.keys().hasOnly(['id', 'date', 'at', 'mid', 'title', 'member', 'base', 'bonus', 'earlyBonus', 'earned', 'due', 'goalMet', 'settled', 'createdAt', 'createdBy']) && logId == d.date + '_' + d.mid + '_' + d.member && d.member == 'm3' && (m.member == 'm3' || m.member == '') && d.title == m.get('title', '') && d.due == due && dueOk(due) && d.base is int && d.base == m.get('points', 0) && isTodayKst(d.date) && d.createdAt == request.time && d.createdBy == request.auth.uid && d.settled == false && atNearServerTime(d.at) && d.goalMet == goalMetOf(d.at, due) && d.bonus is int && d.bonus == 0 && d.earlyBonus is int && d.earlyBonus == earlyBonusOf(d.at, due) && d.earned == d.base + d.earlyBonus; } function childLogDelete() { return resource.data.createdBy == request.auth.uid && resource.data.member == 'm3' && resource.data.settled == false && isTodayKst(resource.data.date); } match /households/{hh}/stats/summary { allow read: if isFamily(); allow write: if isParent() && summaryShape(); } function summaryShape() { let d = request.resource.data; return d.keys().hasAll(['totalXp', 'settledCount', 'monthly', 'updatedAt']) && d.totalXp is int && d.totalXp >= 0 && d.totalXp <= 10000000 && d.settledCount is int && d.settledCount >= 0 && d.monthly is map && d.updatedAt == request.time; } match /households/{hh}/child_state/partner { allow read: if isFamily(); allow write: if isParent() || (isChild() && partnerShape()); } match /households/{hh}/child_state/{docId} { allow read: if isFamily(); allow write: if isParent(); } match /households/{hh}/private/{docId} { allow read, write: if isParent(); } function partnerShape() { let d = request.resource.data; return d.keys().hasAll(['partnerKey', 'updatedAt']) && d.keys().hasOnly(['partnerKey', 'sinceXp', 'updatedAt']) && d.partnerKey is string && d.partnerKey.matches('^[a-z0-9-]{1,40}$') && (!d.keys().hasAll(['sinceXp']) || (d.sinceXp is int && d.sinceXp >= 0 && d.sinceXp <= 10000000)) && d.updatedAt == request.time; } match /households/{hh}/wishlist/{itemId} { allow read: if isFamily(); allow create: if isFamily() && wishCreate(); allow update: if isParent(); allow delete: if isParent() || (isFamily() && resource.data.createdBy == request.auth.uid); } function wishCreate() { let d = request.resource.data; return d.keys().hasAll(['id', 'title', 'need', 'cat', 'at', 'by', 'boughtAt', 'createdBy', 'createdAt']) && d.keys().hasOnly(['id', 'title', 'need', 'cat', 'at', 'by', 'boughtAt', 'createdBy', 'createdAt']) && d.title is string && d.title.size() > 0 && d.title.size() <= 40 && d.need is int && d.need >= 0 && d.need <= 100000 && d.cat in ['toy', 'supply', 'book', 'etc'] && d.at is string && d.at.size() <= 10 && d.by is string && d.by.size() <= 8 && d.createdBy == request.auth.uid && d.createdAt == request.time && (isParent() || (d.boughtAt == '' && d.by == 'm3')); } match /households/{hh}/shopping/{itemId} { allow read: if isFamily(); allow create: if isFamily() && shoppingCreate(); allow update: if (isParent() || (isFamily() && resource.data.createdBy == request.auth.uid)) && shoppingUpdate(); allow delete: if isParent() || (isFamily() && resource.data.createdBy == request.auth.uid); } function shoppingCreate() { let d = request.resource.data; return d.keys().hasAll(['id', 'cat', 'text', 'done', 'createdBy', 'createdAt']) && d.keys().hasOnly(['id', 'cat', 'text', 'done', 'createdBy', 'createdAt']) && d.cat in ['buy', 'fridge'] && d.text is string && d.text.size() > 0 && d.text.size() <= 80 && d.done is bool && d.createdBy == request.auth.uid && d.createdAt == request.time; } function shoppingUpdate() { let d = request.resource.data; let p = resource.data; return d.keys().hasAll(['id', 'cat', 'text', 'done', 'createdBy', 'createdAt']) && d.keys().hasOnly(['id', 'cat', 'text', 'done', 'createdBy', 'createdAt']) && d.cat in ['buy', 'fridge'] && d.text is string && d.text.size() > 0 && d.text.size() <= 80 && d.done is bool && (!p.keys().hasAll(['id']) || d.id == p.id) && (!p.keys().hasAll(['createdBy']) || d.createdBy == p.createdBy) && (!p.keys().hasAll(['createdAt']) || d.createdAt == p.createdAt); } match /households/{hh}/letters/{letterId} { allow read: if isFamily(); allow create: if isFamily() && letterCreate(); allow update: if (isParent() || (isFamily() && resource.data.createdBy == request.auth.uid)) && letterUpdate(); allow delete: if isParent() || (isFamily() && resource.data.createdBy == request.auth.uid); } function letterCreate() { let d = request.resource.data; return d.keys().hasAll(['id', 'img', 'author', 'when', 'createdBy', 'createdAt']) && d.keys().hasOnly(['id', 'img', 'author', 'when', 'createdBy', 'createdAt']) && d.img is string && d.img.size() > 32 && d.img.size() <= 700000 && d.author is string && d.author.size() <= 20 && d.when is string && d.when.size() <= 20 && d.createdBy == request.auth.uid && d.createdAt == request.time; } function letterUpdate() { let d = request.resource.data; let p = resource.data; return d.keys().hasAll(['id', 'img', 'author', 'when', 'createdBy', 'createdAt']) && d.keys().hasOnly(['id', 'img', 'author', 'when', 'createdBy', 'createdAt']) && d.img is string && d.img.size() > 32 && d.img.size() <= 700000 && d.author is string && d.author.size() <= 20 && d.when is string && d.when.size() <= 20 && (!p.keys().hasAll(['id']) || d.id == p.id) && (!p.keys().hasAll(['createdBy']) || d.createdBy == p.createdBy) && (!p.keys().hasAll(['createdAt']) || d.createdAt == p.createdAt); } } }
